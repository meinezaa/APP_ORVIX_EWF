rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role is string
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.matches('[aA][dD][mM][iI][nN]');
    }

    function isOwnProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function canCreateUserProfile(userId) {
      return signedIn()
        && request.auth.token.email is string
        && userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'user_id',
          'nama',
          'email',
          'phone',
          'jenis_kelamin',
          'role',
          'status',
          'isActive',
          'aktif',
          'account_created',
          'pending_registration',
          'createdAt'
        ])
        && request.resource.data.user_id == userId
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0
        && request.resource.data.nama.size() <= 120
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.jenis_kelamin is string
        && request.resource.data.role in ['staff', 'nasabah']
        && request.resource.data.status == 'active'
        && request.resource.data.isActive == true
        && request.resource.data.aktif == true
        && request.resource.data.account_created == true
        && request.resource.data.pending_registration == false
        && request.resource.data.createdAt == request.time;
    }

    function canUpdateOwnProfile(userId) {
      return isOwnProfile(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'user_id',
          'email',
          'user_email',
          'email_address',
          'role',
          'status',
          'isActive',
          'aktif',
          'account_created',
          'pending_registration',
          'createdAt',
          'registeredAt'
        ])
        && !request.resource.data.keys().hasAny([
          'password',
          'passwordHash',
          'password_hash'
        ]);
    }

    match /users/{userId} {
      allow read: if isAdmin()
        || isOwnProfile(userId)
        || (signedIn()
          && request.auth.token.email is string
          && userId == request.auth.token.email);

      allow create: if isAdmin() || canCreateUserProfile(userId);
      allow update: if isAdmin() || canUpdateOwnProfile(userId);
      allow delete: if isAdmin();

      match /{subcollection}/{document=**} {
        allow read, write: if subcollection != 'calculation_history'
          && subcollection != 'login_history'
          && subcollection != 'app_usage'
          && (isAdmin() || isOwnProfile(userId));
      }

      match /app_usage/{usageId} {
        function ownerRole() {
          return get(/databases/$(database)/documents/users/$(userId)).data.role;
        }

        allow read: if isOwnProfile(userId)
          || (isAdmin() && resource.data.role == 'staff');
        allow create, update: if isOwnProfile(userId)
          && request.resource.data.keys().hasOnly([
            'user_id',
            'role',
            'date',
            'minutes'
          ])
          && request.resource.data.user_id == userId
          && request.resource.data.role == ownerRole()
          && request.resource.data.date is string
          && request.resource.data.minutes is number;
        allow delete: if isOwnProfile(userId);
      }

      match /calculation_history/{historyId} {
        function ownerRole() {
          return get(/databases/$(database)/documents/users/$(userId)).data.role;
        }

        allow read: if (isAdmin() && resource.data.role == 'staff')
          || isOwnProfile(userId);
        allow create, update: if isOwnProfile(userId)
          && request.resource.data.user_id == userId
          && request.resource.data.role == ownerRole();
        allow delete: if isOwnProfile(userId);
      }

      match /login_history/{loginId} {
        allow read: if (isAdmin() && resource.data.role == 'staff')
          || isOwnProfile(userId);
        allow create: if isOwnProfile(userId)
          && request.resource.data.user_id == userId
          && request.resource.data.role
            == get(/databases/$(database)/documents/users/$(userId)).data.role;
        allow update: if (isOwnProfile(userId)
            && request.resource.data.role
              == get(/databases/$(database)/documents/users/$(userId)).data.role)
          || (isAdmin()
            && resource.data.role == 'staff'
            && request.resource.data.role == 'staff');
        allow delete: if isOwnProfile(userId)
          || (isAdmin() && resource.data.role == 'staff');

        match /activities/{activityId} {
          allow read, write: if isOwnProfile(userId)
            || (isAdmin()
              && get(/databases/$(database)/documents/users/$(userId)/login_history/$(loginId)).data.role == 'staff');
        }
      }

    }

    match /{path=**}/calculation_history/{historyId} {
      allow read: if isAdmin() && resource.data.role == 'staff';
    }

    match /{path=**}/login_history/{loginId} {
      allow read: if isAdmin() && resource.data.role == 'staff';
    }

    match /{path=**}/app_usage/{usageId} {
      allow read: if isAdmin() && resource.data.role == 'staff';
    }
  }
}
